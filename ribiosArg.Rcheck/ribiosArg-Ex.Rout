> nameEx("makeFactor")
> ### * makeFactor
> 
> flush(stderr()); flush(stdout())
> 
> ### Name: makeFactor
> ### Title: Make a factor
> ### Aliases: makeFactor
> 
> ### ** Examples
> 
> makeFactor(c("A", "B", "C", "C", "A"), levels=LETTERS[3:1])
[1] A B C C A
Levels: C B A
> makeFactor(c("A 1", "B 2", "C 3", "C 3", "A 1"),
+     levels=c("A 1", "C 3", "B 2"),
+     make.names=TRUE)
[1] A.1 B.2 C.3 C.3 A.1
Levels: A.1 C.3 B.2
> makeFactor(c("A 1", "B 2", "C 3", "C 3", "A 1"),
+     levels=c("A 1", "C 3", "B 2"),
+     make.names=FALSE)
[1] A 1 B 2 C 3 C 3 A 1
Levels: A 1 C 3 B 2
> makeFactor(c("A 1", "B 2", "C 3", "C 3", "A 1"),
+     levels=c("A 1", "C 3", "B 2"),
+     make.names=FALSE, verbose=TRUE)
[1] A 1 B 2 C 3 C 3 A 1
Levels: A 1 C 3 B 2
